<Window x:Class="ProjectUpdateCloner.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Project Update Cloner"
        MinWidth="980"
        MinHeight="690"
        Width="1160"
        Height="760"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Icon="/Assets/app.ico"
        Background="{DynamicResource SurfaceBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Height="36"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="10,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Image Source="/Assets/app.ico"
                           Width="16"
                           Height="16"
                           Margin="0,0,8,0" />
                    <TextBlock Text="Project Update Cloner"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="12"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Stretch">
                    <Button Style="{StaticResource TitleBarButton}"
                            Click="MinimizeButton_Click"
                            ToolTip="Minimize"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Viewbox Width="12" Height="12">
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  Data="M 2 6 L 10 6" />
                        </Viewbox>
                    </Button>
                    <Button Style="{StaticResource TitleBarButton}"
                            Click="MaximizeButton_Click"
                            ToolTip="Maximize"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Viewbox Width="12" Height="12">
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.45"
                                  StrokeLineJoin="Round"
                                  Data="M 2.5 2.5 L 9.5 2.5 L 9.5 9.5 L 2.5 9.5 Z" />
                        </Viewbox>
                    </Button>
                    <Button Style="{StaticResource TitleBarCloseButton}"
                            Click="CloseButton_Click"
                            ToolTip="Close"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Viewbox Width="12" Height="12">
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.7"
                                  StrokeStartLineCap="Round"
                                  Data="M 3 3 L 9 9 M 9 3 L 3 9" />
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Image Source="{DynamicResource HeaderLogoSource}"
                   Height="64"
                   Width="300"
                   Stretch="Uniform"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center" />

            <Border Grid.Column="1"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8"
                    MinHeight="58"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource CopiedBadgeBrush}"
                            BorderBrush="{DynamicResource CopiedBadgeBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,7"
                            Margin="0,0,6,0">
                        <TextBlock FontSize="12"
                                   Foreground="{DynamicResource CopiedBadgeTextBrush}">
                            <Run Text="Copied " />
                            <Run Text="{Binding CopiedCount, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                    </Border>
                    <Border Background="{DynamicResource SkippedBadgeBrush}"
                            BorderBrush="{DynamicResource SkippedBadgeBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,7"
                            Margin="0,0,6,0">
                        <TextBlock FontSize="12"
                                   Foreground="{DynamicResource SkippedBadgeTextBrush}">
                            <Run Text="Skipped " />
                            <Run Text="{Binding SkippedCount, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                    </Border>
                    <Border Background="{DynamicResource MatchedBadgeBrush}"
                            BorderBrush="{DynamicResource MatchedBadgeBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,7"
                            Margin="0,0,6,0">
                        <TextBlock FontSize="12"
                                   Foreground="{DynamicResource MatchedBadgeTextBrush}">
                            <Run Text="Matched " />
                            <Run Text="{Binding MatchedCount, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                    </Border>
                    <Border Background="{DynamicResource ErrorBadgeBrush}"
                            BorderBrush="{DynamicResource ErrorBadgeBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,7"
                            Margin="0,0,12,0">
                        <TextBlock FontSize="12"
                                   Foreground="{DynamicResource ErrorBadgeTextBrush}">
                            <Run Text="Errors " />
                            <Run Text="{Binding ErrorCount, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                    </Border>

                    <Border Background="{DynamicResource InputBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="14,7"
                            MinWidth="170"
                            Margin="0,0,12,0">
                        <TextBlock Text="{Binding StatusText}"
                                   FontSize="13"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>

                    <Button Style="{StaticResource PrimaryButton}"
                            Content="New Work"
                            Command="{Binding RefreshCommand}"
                            MinHeight="36"
                            Padding="18,7"
                            VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="350" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}"
                                   Text="Project Paths"
                                   Margin="0,0,0,12" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Source Project Folder" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="88" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding SourceFolder, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="2"
                                    Content="Browse"
                                    Command="{Binding BrowseSourceCommand}" />
                        </Grid>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Output Folder" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="88" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="2"
                                    Content="Browse"
                                    Command="{Binding BrowseOutputCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2"
                        Background="{DynamicResource ConsoleBrush}"
                        BorderBrush="{DynamicResource ConsoleBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="{DynamicResource ConsoleHeaderBrush}"
                                CornerRadius="4"
                                Padding="14,10">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="Run Progress"
                                           FontWeight="SemiBold"
                                           Foreground="White" />
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding ProgressText}"
                                           Foreground="#CBD5E1"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="520" />
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="1"
                                Background="{DynamicResource ConsoleProgressStripBrush}"
                                BorderBrush="{DynamicResource ConsoleBorderBrush}"
                                BorderThickness="0,1,0,1"
                                Padding="14,10">
                            <ProgressBar Minimum="0"
                                         Maximum="100"
                                         Value="{Binding ProgressValue, Mode=OneWay}"
                                         IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}" />
                        </Border>

                        <TextBox Grid.Row="2"
                                 Text="{Binding LogText, Mode=OneWay}"
                                 FontFamily="Consolas"
                                 FontSize="13"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 AcceptsReturn="True"
                                 IsReadOnly="True"
                                 TextWrapping="NoWrap"
                                 VerticalContentAlignment="Top"
                                 Background="{DynamicResource ConsoleBrush}"
                                 Foreground="{DynamicResource ConsoleTextBrush}"
                                 BorderThickness="0"
                                 Padding="10"
                                 MinHeight="320" />
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}"
                                   Text="Package Settings"
                                   Margin="0,0,0,12" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Date Of Update" />
                        <DatePicker SelectedDate="{Binding SelectedDate}"
                                    Margin="0,0,0,12" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="File Type Filters" />
                        <TextBox Text="{Binding FilePatterns, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Examples: *.php, *.js, resources/*.blade.php"
                                 Margin="0,0,0,12" />

                        <Border Background="{DynamicResource PanelAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="12"
                                Margin="0,0,0,14">
                            <StackPanel>
                                <CheckBox Content="Preserve folder structure"
                                          IsChecked="{Binding PreserveStructure}" />
                                <CheckBox Content="Create zip file"
                                          IsChecked="{Binding CreateZip}" />
                                <CheckBox Content="Use common ignores"
                                          IsChecked="{Binding UseCommonIgnores}"
                                          ToolTip="Ignores vendor, node_modules, bin, obj, .git, and storage/logs." />
                                <CheckBox Content="Include hidden files"
                                          IsChecked="{Binding IncludeHiddenFiles}"
                                          Margin="0" />
                            </StackPanel>
                        </Border>

                        <Button Style="{StaticResource PrimaryButton}"
                                Content="Generate Update Package"
                                Command="{Binding GenerateCommand}" />

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,12,0,0"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid Width="20"
                                  Height="20"
                                  RenderTransformOrigin="0.5,0.5"
                                  Margin="0,0,8,0">
                                <Grid.RenderTransform>
                                    <RotateTransform />
                                </Grid.RenderTransform>
                                <Grid.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                                                 From="0"
                                                                 To="360"
                                                                 Duration="0:0:0.9" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Grid.Triggers>
                                <Ellipse Stroke="{DynamicResource AccentBorderBrush}"
                                         StrokeThickness="3" />
                                <Path Stroke="{DynamicResource AccentBrush}"
                                      StrokeThickness="3"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M10,2 A8,8 0 0 1 18,10" />
                            </Grid>
                            <TextBlock Text="Generating package..."
                                       FontSize="12"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <Button Content="Check Output Folder"
                                Command="{Binding OpenDestinationCommand}"
                                MinHeight="50"
                                Margin="0,12,0,0"
                                Visibility="{Binding IsDestinationAvailable, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="2"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Style="{StaticResource SectionTitle}"
                                   Text="Skip Folders"
                                   Margin="0,0,0,6" />
                        <TextBlock Grid.Row="1"
                                   Text="Check The Folders You Want To Skip."
                                   FontSize="12"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10" />

                        <Border Grid.Row="2"
                                Background="{DynamicResource PanelAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding ProjectFolders}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource InputBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="8,6"
                                                    Margin="0,0,0,6">
                                                <CheckBox IsChecked="{Binding IsIgnored, Mode=TwoWay}"
                                                          ToolTip="{Binding RelativePath}"
                                                          Margin="0">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </CheckBox>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>

            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Margin="0,14,0,0"
                Background="{DynamicResource WarningBackgroundBrush}"
                BorderBrush="{DynamicResource WarningBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12,9"
                HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <Border Background="{DynamicResource WarningBadgeBrush}"
                        CornerRadius="4"
                        Padding="7,2"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="Important"
                               Foreground="White"
                               FontSize="11"
                               FontWeight="SemiBold" />
                </Border>
                <TextBlock Foreground="{DynamicResource WarningTextBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           MaxWidth="900"
                           Text="Select A Project Folder, Output Folder, Date, Filters, And Folders To Skip. The App Copies Only Matching Changed Files Into A New Projectname-Updates-YYYY-MM-DD-HH-MM Package And Preserves Folder Structure. It Never Deletes Or Changes Any Source File Or Folder." />
            </StackPanel>
        </Border>
        </Grid>
    </Grid>
</Window>
